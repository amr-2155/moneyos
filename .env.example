# ==========================================================================
# MoneyOS server configuration
# Copy this file to `.env` and adjust values. Never commit `.env`.
# ==========================================================================

# --- Server ---
NODE_ENV=development
PORT=3001
HOST=127.0.0.1

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# SQLite file path. Relative paths resolve from the project root.
DATABASE_URL=./data/moneyos.db

# --- Authentication ---
# Required in production. In development, if unset, an ephemeral secret is
# generated at startup (sessions will not survive restarts).
# Use at least 32 random characters: e.g. `openssl rand -hex 32`
JWT_SECRET=

# Access token lifetime (default 15 minutes).
JWT_EXPIRES_IN=15m

# Refresh token lifetime in days (default 30).
REFRESH_TOKEN_TTL_DAYS=30

# Password reset token lifetime in minutes (default 30).
PASSWORD_RESET_TTL_MINUTES=30

# --- App ---
APP_NAME=MoneyOS
DEFAULT_CURRENCY=EGP

# Public base URL of the frontend; used to build password-reset links.
PUBLIC_APP_URL=http://localhost:5173

# --- Mailer (Phase 1 uses a console/dev mailer that logs reset links) ---
# In production, implement a real provider behind the Mailer interface.
MAILER_FROM=MoneyOS <no-reply@moneyos.local>
